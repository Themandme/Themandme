# Magnolia environment.
#
# Copy to `.env` and fill in. Every variable below is read by the zod loader in
# `packages/config`. There are NO silent defaults: a variable that is required for the
# selected MAGNOLIA_ENV and is missing will throw at boot, naming itself.
#
# An empty value (`FOO=`) counts as absent, not as an empty string.
#
# Load in development with Node's native flag:  node --env-file=.env ...

# ─── Core ────────────────────────────────────────────────────────────────────────────
# Selects every other rule in this file. Validated before anything else.
# One of: local | staging | production
MAGNOLIA_ENV=local

# One of: trace | debug | info | warn | error
LOG_LEVEL=info

# ─── API ─────────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000

# Session cookie signing key for the operator dashboard (spec §12, BUILD_PLAN M8.3).
# Minimum 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-at-least-32-characters-of-random

# ─── Datastores ──────────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults.
DATABASE_URL=postgres://magnolia:magnolia@localhost:5432/magnolia
REDIS_URL=redis://localhost:6379

# ─── Object storage (S3-compatible; Cloudflare R2 in production) ─────────────────────
# Raw source payloads, call recordings, transaction PDFs. Spec §3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=magnolia-local
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key

# ─── Ingestion ───────────────────────────────────────────────────────────────────────
# Spec §4.5 MUST: every adapter sends a descriptive User-Agent with a contact address.
OUTBOUND_USER_AGENT=Magnolia/0.1 (+mailto:ops@example.com)

# ─── LLM ─────────────────────────────────────────────────────────────────────────────
# Optional in local (providers are faked). Required in staging and production.
ANTHROPIC_API_KEY=

# ─── Observability ───────────────────────────────────────────────────────────────────
# Optional in local. Required in staging and production.
SENTRY_DSN=

# ─── Communications credentials ──────────────────────────────────────────────────────
# Spec §3.2 MUST: in `local` and `staging`, CommsProvider implementations are physically
# absent from the DI container — "blocking outbound must not depend on a runtime flag being
# set correctly". The loader enforces the same thing one level down: setting any variable in
# this block while MAGNOLIA_ENV is local or staging is a validation error, not a warning.
#
# Leave every one of these unset outside production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VOICE_NUMBER=
LOB_API_KEY=
POSTMARK_SERVER_TOKEN=
BLAND_API_KEY=

# The published inbound number that mailers point at. AI voice is inbound-only (spec §2.1).
MAGNOLIA_PUBLIC_VOICE_NUMBER=

# ─── Paid data credentials (T3) ──────────────────────────────────────────────────────
# Per-lookup billing. Forbidden in local (fakes only), optional in staging, required in
# production. Spec §5.1, §9.2.
SKIPTRACE_API_KEY=
PHONE_VALIDATION_API_KEY=
